DEEPSEEK_API_KEY=your_api_key_here

DEEPSEEK_BASE_URL=https://api.deepseek.com
# API model id (DeepSeek-V4.1-Flash is served by the "deepseek-flash" model id)
DEEPSEEK_MODEL=deepseek-flash

# Optional overrides (defaults shown)
# DEEPSEEK_THINKING=enabled            # enabled | disabled
# DEEPSEEK_REASONING_EFFORT=           # low | high | max (empty = API default)
# DEEPSEEK_MAX_OUTPUT_TOKENS=2048
# DEEPSEEK_TEMPERATURE=0
# DEEPSEEK_MAX_RETRIES=4
# LLM_CACHE=1                          # 0 disables the on-disk response cache
